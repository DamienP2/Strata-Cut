diff --git a/web/src/styles.css b/web/src/styles.css
index 6ef6b33..7ed4328 100644
--- a/web/src/styles.css
+++ b/web/src/styles.css
@@ -1175,3 +1175,26 @@ a.btn { color: inherit; }
 /* Système › YouTube. */
 .sc-yt-note { font-size: 13px; margin: 0 0 4px; display: flex; align-items: center; gap: 6px; }
 .set-card .sc-yt-note { display: block; }
+
+/* Maquette (proposal only): the card's gauge. */
+.sc-state.rec { display: inline-flex; align-items: center; gap: 5px; background: var(--live-soft); color: var(--live); letter-spacing: 0.04em; }
+.sc-state.rec .sc-rec { width: 6px; height: 6px; }
+.project-card .project-body .mq-a, .project-card .project-body .mq-b, .project-card .project-body .mq-c { margin-top: auto; }
+.mq-a { display: flex; align-items: center; gap: 10px; padding: 6px 0 2px; }
+.mq-a .mq-bar { flex: 1; height: 6px; border-radius: 3px; background: var(--panel-3); overflow: hidden; }
+.mq-a .mq-bar > span { display: block; height: 100%; border-radius: 3px; background: var(--accent); }
+.mq-a .mq-txt { font-size: 12px; color: var(--text-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
+.mq-a .mq-txt b { color: var(--text); font-weight: 600; }
+.mq-b { display: flex; flex-direction: column; gap: 6px; padding: 4px 0 2px; }
+.mq-b .mq-txt { font-variant-numeric: tabular-nums; color: var(--text-3); font-size: 12px; }
+.mq-b .mq-txt b { font-size: 17px; color: var(--text); font-weight: 650; letter-spacing: -0.01em; }
+.mq-b .mq-bar { position: relative; height: 8px; border-radius: 4px; background: var(--panel-3); overflow: hidden; }
+.mq-b .mq-bar > span { position: absolute; inset: 0 auto 0 0; border-radius: 4px; background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 55%, transparent), var(--accent)); }
+.mq-b .mq-bar > i { position: absolute; top: 0; bottom: 0; width: 1px; background: color-mix(in srgb, var(--bg) 70%, transparent); }
+.mq-c { display: flex; align-items: center; gap: 10px; padding: 4px 0 0; }
+.mq-ring { width: 34px; height: 34px; transform: rotate(-90deg); flex: none; }
+.mq-ring circle { fill: none; stroke: var(--panel-3); stroke-width: 4; }
+.mq-ring circle.on { stroke: var(--accent); stroke-linecap: round; }
+.mq-c .mq-txt { display: flex; align-items: baseline; gap: 5px; font-variant-numeric: tabular-nums; }
+.mq-c .mq-txt b { font-size: 16px; font-weight: 650; color: var(--text); }
+.mq-c .mq-txt small { color: var(--text-3); font-size: 12px; }
